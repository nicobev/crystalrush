{
  "name": "crystalrush",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared":{
        "$path": "dist/shared",
        "$ignoreUnknownInstances": true
      },
      "Packages": {
        "$path": "Packages",
        "$ignoreUnknownInstances": true
      },
      "Client":{
        "$path": "dist/client/source",
        "$ignoreUnknownInstances": true
      },
      "$ignoreUnknownInstances": true
    },

    "ServerScriptService": {
      "$path": "dist/server/runtime",
      "$ignoreUnknownInstances": true
    },

    "ServerStorage": {
      "$path": "dist/server/source",
      "$ignoreUnknownInstances": true,
      "ServerPackages": {
        "$path": "ServerPackages",
        "$ignoreUnknownInstances": true
      }
    },
    

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "dist/client/runtime",
        "$ignoreUnknownInstances": true
      },
      "$ignoreUnknownInstances": true
    }
  }
}